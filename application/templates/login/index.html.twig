{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block layout %}
    <div class="auth-shell">
        <form action="{{ path('login') }}" method="post" class="card auth-card animate-in">
            <a href="{{ path('app_home') }}" class="brand">
                {{ include('_brand_mark.html.twig') }} Achim Krämer
            </a>

            <h1>Willkommen zurück</h1>
            <p class="subtitle">Bitte melden Sie sich an, um fortzufahren.</p>

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="field">
                <label for="username">E-Mail</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}"
                       placeholder="name@beispiel.de" autocomplete="email" required autofocus>
            </div>

            <div class="field">
                <label for="password">Passwort</label>
                <input type="password" id="password" name="_password"
                       placeholder="••••••••" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_target_path" value="{{ path('homepage') }}"/>

            <button type="submit" class="btn btn-primary btn-block">Anmelden</button>
        </form>
    </div>
{% endblock %}
