<form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" class="inline-form" onsubmit="return confirm('Diesen Benutzer wirklich löschen?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-danger btn-sm">Löschen</button>
</form>
