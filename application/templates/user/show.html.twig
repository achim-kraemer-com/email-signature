{% extends 'base.html.twig' %}

{% block title %}Benutzer{% endblock %}

{% block body %}
    <div class="breadcrumb"><a href="{{ path('app_user_index') }}">Benutzer</a> / {{ user.email }}</div>
    <div class="page-head"><h1>Benutzer</h1></div>

    <div class="card detail-card">
        <dl>
            <dt>E-Mail</dt><dd>{{ user.email }}</dd>
            <dt>Rollen</dt><dd>{{ user.roles ? user.roles|json_encode : '' }}</dd>
            <dt>Id</dt><dd>{{ user.id }}</dd>
            <dt>CreatedAt</dt><dd>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }}</dd>
            <dt>UpdatedAt</dt><dd>{{ user.updatedAt ? user.updatedAt|date('Y-m-d H:i:s') : '' }}</dd>
        </dl>
    </div>

    <div class="form-actions">
        <a href="{{ path('app_user_index') }}" class="btn btn-ghost">← Zurück zur Liste</a>
        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">Bearbeiten</a>
    </div>

    <div style="margin-top: 1.5rem;">
        {{ include('user/_delete_form.html.twig') }}
    </div>
{% endblock %}
