{% extends 'base.html.twig' %}

{% block title %}Signatur anzeigen{% endblock %}

{% block body %}
    <div class="breadcrumb"><a href="{{ path('homepage') }}">Signaturen</a> / Anzeigen</div>
    <div class="page-head"><h1>E-Mail Signatur</h1></div>

    <div class="card detail-card">
        <h3>Signatur 1</h3>
        <div class="signature-block">
            <div class="signature-preview no-pico-wrapper">
                <div id="signature1">
                    {{ include('signature/signature1.html.twig') }}
                </div>
            </div>
            <button id="copy-signature-1" class="btn btn-primary btn-sm">Signatur kopieren</button>
        </div>

        <h3 style="margin-top: 2rem;">Signatur 2</h3>
        <div class="signature-block">
            <div class="signature-preview no-pico-wrapper">
                <div id="signature2">
                    {{ include('signature/signature2.html.twig') }}
                </div>
            </div>
            <button id="copy-signature-2" class="btn btn-primary btn-sm">Signatur kopieren</button>
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ path('homepage') }}" class="btn btn-ghost">← Zurück zur Liste</a>
    </div>
{% endblock %}

{% block javascripts %}
    {{ importmap('signature') }}
{% endblock %}
