<form method="post" action="{{ path('app_signature_delete', {'id': signature.id}) }}" class="inline-form" onsubmit="return confirm('Diese Signatur wirklich löschen?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ signature.id) }}">
    <button class="btn btn-danger btn-sm">Löschen</button>
</form>
