{{ form_start(form) }}
    <div class="signature-form-grid">
        <div>
            {{ form_row(form.signatureName) }}
            {{ form_row(form.welcome) }}
            {{ form_row(form.firstName) }}
            {{ form_row(form.lastName) }}
            {{ form_row(form.jobTitle) }}
            {{ form_row(form.companyName) }}
            {{ form_row(form.owner) }}
            {{ form_row(form.street) }}
            {{ form_row(form.houseNumber) }}
            {{ form_row(form.postalCode) }}
            {{ form_row(form.city) }}
        </div>
        <div>
            {{ form_row(form.email) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.mobile) }}
            {{ form_row(form.fax) }}
            {{ form_row(form.logo) }}
            {% if signature.logo is not null %}
                <div class="email-signal-img">
                    <img src="{{ absolute_url(asset(signature.logo)) }}" alt="Logo">
                </div>
            {% endif %}
        </div>
        <div>
            {{ form_row(form.website) }}
            {{ form_row(form.instagram) }}
            {{ form_row(form.facebook) }}
            {{ form_row(form.linkedin) }}
            {{ form_row(form.xing) }}
            {{ form_row(form.github) }}
            {{ form_row(form.tagNumber) }}
            {{ form_row(form.bank) }}
            {{ form_row(form.iban) }}
            {{ form_row(form.bic) }}
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">{{ button_label|default('Speichern') }}</button>
        {% if cancel_path is defined %}
            <a href="{{ cancel_path }}" class="btn btn-ghost">Abbrechen</a>
        {% endif %}
    </div>
{{ form_end(form) }}
